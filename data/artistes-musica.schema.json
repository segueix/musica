{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Base d'artistes de Segueix Música",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "artists"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "artists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "aliases",
          "genres",
          "territories",
          "languages",
          "wikidataId",
          "musicbrainzId",
          "youtube",
          "confidence",
          "reviewStatus",
          "active",
          "sources",
          "lastChecked",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Pop",
                "Rock",
                "Indie / Alternativa",
                "Urbana",
                "Rap / Hip-hop",
                "Electrònica",
                "Folk i arrel",
                "Cançó d'autor",
                "Ska / Reggae",
                "Punk",
                "Metal",
                "Rumba / Mestissatge",
                "Flamenc",
                "Jazz / Blues",
                "Funk / Soul / R&B",
                "Clàssica i contemporània",
                "Coral / Vocal",
                "Experimental / Avantguarda",
                "Infantil",
                "Altres"
              ]
            },
            "uniqueItems": true
          },
          "territories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "wikidataId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^Q[0-9]+$"
          },
          "musicbrainzId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F-]{36}$"
          },
          "youtube": {
            "type": "object",
            "required": [
              "channels"
            ],
            "additionalProperties": false,
            "properties": {
              "channels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "handle",
                    "name",
                    "type",
                    "primary"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^UC[A-Za-z0-9_-]{22}$"
                    },
                    "handle": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^@.+"
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "type": {
                      "enum": [
                        "official",
                        "topic",
                        "label",
                        "other"
                      ]
                    },
                    "primary": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "url",
                    "handle",
                    "relationType",
                    "source",
                    "discoveredAt"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "handle": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "relationType": {
                      "enum": [
                        "youtube",
                        "youtube-music",
                        "video-channel"
                      ]
                    },
                    "source": {
                      "const": "musicbrainz"
                    },
                    "discoveredAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              },
              "searchCandidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "handle",
                    "description",
                    "subscriberCount",
                    "thumbnail",
                    "score",
                    "reasons",
                    "suggestedType",
                    "discoveredAt"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^UC[A-Za-z0-9_-]{22}$"
                    },
                    "title": {
                      "type": "string"
                    },
                    "handle": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "description": {
                      "type": "string"
                    },
                    "subscriberCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "thumbnail": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "score": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "suggestedType": {
                      "enum": [
                        "official",
                        "topic"
                      ]
                    },
                    "discoveredAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "confidence": {
            "enum": [
              "alta",
              "mitjana",
              "baixa",
              "pendent"
            ]
          },
          "reviewStatus": {
            "enum": [
              "pendent",
              "aprovat",
              "rebutjat"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "lastChecked": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          },
          "enrichment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "musicbrainz": {
                "type": "object",
                "required": [
                  "checkedAt",
                  "status"
                ],
                "additionalProperties": true,
                "properties": {
                  "checkedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "status": {
                    "enum": [
                      "pendent",
                      "trobat",
                      "sense-youtube",
                      "error"
                    ]
                  },
                  "relationCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "error": {
                    "type": "string"
                  }
                }
              },
              "youtubeSearch": {
                "type": "object",
                "required": [
                  "checkedAt",
                  "status",
                  "query",
                  "resultCount",
                  "bestScore",
                  "autoAcceptedId"
                ],
                "additionalProperties": true,
                "properties": {
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "status": {
                    "enum": [
                      "autoacceptat",
                      "candidats",
                      "sense-resultats",
                      "error"
                    ]
                  },
                  "query": {
                    "type": "string"
                  },
                  "resultCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "bestScore": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "autoAcceptedId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "error": {
                    "type": "string"
                  }
                }
              },
              "genres": {
                "type": "object",
                "required": [
                  "checkedAt",
                  "musicbrainzCheckedAt",
                  "wikidataRaw",
                  "musicbrainzRaw",
                  "unmappedRaw",
                  "status"
                ],
                "additionalProperties": true,
                "properties": {
                  "checkedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "musicbrainzCheckedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "wikidataRaw": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "musicbrainzRaw": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "unmappedRaw": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "status": {
                    "enum": [
                      "pendent",
                      "classificat",
                      "parcial",
                      "per-revisar",
                      "sense-dades"
                    ]
                  },
                  "musicbrainzError": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "genresRaw": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
