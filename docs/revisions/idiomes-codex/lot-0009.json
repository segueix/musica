  "decisions": [
    {
      "id": "B5yJDTeAUoQ",
      "accio": "pendent",
      "motiu": "La cerca identifica la col·laboració de Patos Gang Vol. 1, però la pàgina oberta no retorna text i no s'ha trobat una lletra completa verificable.",
      "fonts": [
        {
          "url": "https://open.spotify.com/track/55xudY37mZuwjIyNhg0cvg",
          "consultada": "2026-10-22T18:55:13.919Z",
          "llegida": false,
          "coincidenciaVersio": false
        }
      ]
    },
    {
      "id": "CSRFnj5AfLc",
      "accio": "pendent",
      "motiu": "La fitxa oberta d'Ies Que Mai no conté la lletra d'aquest tema, només fragments d'altres cançons de Good Jan.",
      "fonts": [
        {
          "url": "https://sonichits.com/video/Good_Jan/Ies_que_mai",
          "consultada": "2026-10-22T18:55:13.919Z",
