          "coincidenciaVersio": true
        }
      ]
    },
    {
      "id": "nFrEAQcrgdo",
      "accio": "pendent",
      "motiu": "Col·laboració de Sie777e i Good Jan identificada, però la fitxa accessible no ofereix la lletra completa. No es pot determinar la llengua de totes les parts.",
      "fonts": [
        {
          "url": "https://music.apple.com/us/song/no-new-nais/1633350352",
          "consultada": "2026-10-22T18:55:13.919Z",
          "llegida": true,
          "coincidenciaVersio": true
        }
      ]
    },
    {
      "id": "7rD-IIIeJnM",
      "accio": "pendent",
      "motiu": "La fitxa de Squad amb Monrra Straps i Maken Row no s'ha pogut llegir. No s'hi trasllada la lletra de Squad Garrera Darrera, que és un altre enregistrament.",
      "fonts": [
        {
          "url": "https://www.viasona.cat/grup/monrra-straps.good-jan.maken-row/squad",
          "consultada": "2026-10-22T18:55:13.919Z",
