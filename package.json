{
  "name": "segueix-musica",
  "private": true,
  "description": "Segueix Música — PWA per descobrir música en català",
  "scripts": {
    "lint": "eslint 'js/**/*.js'",
    "lint:fix": "eslint --fix 'js/**/*.js'",
    "format": "prettier --write 'js/**/*.js' '*.js' '*.json' 'css/**/*.css'",
    "format:check": "prettier --check 'js/**/*.js' '*.js' '*.json' 'css/**/*.css'",
    "test": "vitest run",
    "test:watch": "vitest",
    "music:validate": "node scripts/validar_artistes_musica.js",
    "music:discover": "node scripts/descobrir_artistes_musica.js",
    "music:discover:dry": "node scripts/descobrir_artistes_musica.js --dry-run --limit=100",
    "search:index": "node scripts/generar_index_cerca.js",
    "search:index:hybrid:rebuild": "node scripts/generar_index_cerca.js",
    "sw:version": "node scripts/actualitzar_versio_sw.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "vitest": "^4.1.0"
  }
}
